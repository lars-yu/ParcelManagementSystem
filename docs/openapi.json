  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Login": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "Receive": {
        "type": "object",
        "required": [
          "tracking_no",
          "recipient",
          "phone",
          "location",
          "request_key"
        ],
        "properties": {
          "tracking_no": {
            "type": "string",
            "maxLength": 64
          },
          "recipient": {
            "type": "string",
            "maxLength": 100
          },
          "phone": {
            "type": "string",
            "pattern": "^[0-9]{6,20}$"
          },
          "carrier": {
            "type": "string",
            "maxLength": 40,
            "default": "未指定"
          },
          "location": {
            "type": "string",
            "maxLength": 40
          },
          "request_key": {
            "type": "string",
            "maxLength": 100
          }
        }
      },
      "Pickup": {
        "type": "object",
        "required": [
          "recipient",
          "pickup_code"
        ],
        "properties": {
          "recipient": {
            "type": "string"
          },
          "pickup_code": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          }
        }
      },
      "Exception": {
        "type": "object",
        "required": [
          "kind",
          "note"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "damaged",
              "address_error",
              "refused",
              "lost",
              "other"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "Resolve": {
        "type": "object",
        "required": [
          "resolution",
          "note"
        ],
        "properties": {
          "resolution": {
            "type": "string",
            "enum": [
              "restore",
              "return"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "Location": {
        "type": "object",
        "required": [
          "location"
        ],
        "properties": {
          "location": {
            "type": "string",
            "maxLength": 40
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "username",
          "password",
          "role"
        ],
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 256
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "manager",
              "clerk",
              "auditor"
            ]
          }
        }
      },
      "Dispatch": {
        "type": "object",
        "required": [],
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          }
        }
      }
    }
  }
}